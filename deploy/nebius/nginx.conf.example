# Install inside nginx's http {} context after TLS and deployment review.
# Never expose port 8765. There is no direct filesystem alias to private media.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name framefix.net www.framefix.net;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
    }
    location / {
        return 308 https://framefix.net$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name www.framefix.net;
    ssl_certificate /etc/letsencrypt/live/framefix.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/framefix.net/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 308 https://framefix.net$request_uri;
}

server {
    listen 443 ssl;
    server_name framefix.net;
    ssl_certificate /etc/letsencrypt/live/framefix.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/framefix.net/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    if ($host != framefix.net) { return 444; }

    client_max_body_size 500m;
    client_body_timeout 180s;
    access_log off;
    error_log /var/log/nginx/frameseek-error.log warn;
    add_header X-Content-Type-Options nosniff always;

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host framefix.net;
        proxy_set_header Connection "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-FS-Gateway-Token "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        proxy_next_upstream off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 180s;
        proxy_read_timeout 300s;
    }
}
