# Inert template. Install as /etc/frameseek/workspace.env after deployment approval.
FS_PUBLIC_ORIGIN=https://framefix.net
FS_DATA_DIR=/srv/frameseek/workspace
FRAMESEEK_MODE=fixture
FRAMESEEK_COARSE_FRAMES=8
FRAMESEEK_RERANK_K=1
FRAMESEEK_TTL_HOURS=24
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
# No runtime, key or spending approval is installed by this template.
# Later live setup: FS_RUNTIME_FILE=/etc/frameseek/runtime.json
# Put NEBIUS_API_KEY only in root-owned mode-0600 /etc/frameseek/secrets.env.
# Native same-host Nginx ingress does not use FS_GATEWAY_TOKEN or FS_BACKEND_ORIGIN.
